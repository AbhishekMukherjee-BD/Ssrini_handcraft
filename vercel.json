{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/ecom/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/css/:path*", "destination": "/ecom/css/:path*" },
    { "source": "/js/:path*", "destination": "/ecom/js/:path*" },
    { "source": "/assets/:path*", "destination": "/ecom/assets/:path*" },
    { "source": "/preloader_images/:path*", "destination": "/ecom/preloader_images/:path*" },
    { "source": "/landing/:path*", "destination": "/ecom/landing/:path*" },
    { "source": "/favicon.ico", "destination": "/ecom/favicon.ico" },
    { "source": "/store/assets/:path*", "destination": "/ecom/store/assets/:path*" },
    { "source": "/store/css/:path*", "destination": "/ecom/store/css/:path*" },
    { "source": "/store/js/:path*", "destination": "/ecom/store/js/:path*" },
    { "source": "/collection/assets/:path*", "destination": "/ecom/collection/assets/:path*" },
    { "source": "/collection/css/:path*", "destination": "/ecom/collection/css/:path*" },
    { "source": "/collection/js/:path*", "destination": "/ecom/collection/js/:path*" },
    { "source": "/admin/assets/:path*", "destination": "/admin/ssrini-handicrafts-admin/assets/:path*" },
    { "source": "/assets/css/admin.css", "destination": "/admin/ssrini-handicrafts-admin/assets/css/admin.css" },
    { "source": "/assets/js/admin-data.js", "destination": "/admin/ssrini-handicrafts-admin/assets/js/admin-data.js" },
    { "source": "/ecom", "destination": "/ecom/index.html" },
    { "source": "/ecom/", "destination": "/ecom/index.html" },
    { "source": "/ecom/store", "destination": "/ecom/store/index.html" },
    { "source": "/ecom/store/", "destination": "/ecom/store/index.html" },
    { "source": "/ecom/store/product", "destination": "/ecom/store/product.html" },
    { "source": "/ecom/store/product/", "destination": "/ecom/store/product.html" },
    { "source": "/ecom/store/checkout", "destination": "/ecom/store/checkout.html" },
    { "source": "/ecom/store/checkout/", "destination": "/ecom/store/checkout.html" },
    { "source": "/ecom/store/invoice", "destination": "/ecom/store/invoice.html" },
    { "source": "/ecom/store/invoice/", "destination": "/ecom/store/invoice.html" },
    { "source": "/ecom/store/account", "destination": "/ecom/store/account.html" },
    { "source": "/ecom/store/account/", "destination": "/ecom/store/account.html" },
    { "source": "/ecom/collection", "destination": "/ecom/collection/index.html" },
    { "source": "/ecom/collection/", "destination": "/ecom/collection/index.html" },
    { "source": "/ecom/about", "destination": "/ecom/about/index.html" },
    { "source": "/ecom/about/", "destination": "/ecom/about/index.html" },
    { "source": "/ecom/contact", "destination": "/ecom/contact/index.html" },
    { "source": "/ecom/contact/", "destination": "/ecom/contact/index.html" },
    { "source": "/ecom/privacy", "destination": "/ecom/privacy/index.html" },
    { "source": "/ecom/privacy/", "destination": "/ecom/privacy/index.html" },
    { "source": "/ecom/terms", "destination": "/ecom/terms/index.html" },
    { "source": "/ecom/terms/", "destination": "/ecom/terms/index.html" },
    { "source": "/ecom/auth", "destination": "/ecom/auth/login.html" },
    { "source": "/ecom/auth/", "destination": "/ecom/auth/login.html" },
    { "source": "/ecom/auth/login", "destination": "/ecom/auth/login.html" },
    { "source": "/ecom/auth/login/", "destination": "/ecom/auth/login.html" },
    { "source": "/admin", "destination": "/admin/ssrini-handicrafts-admin/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/ssrini-handicrafts-admin/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/ssrini-handicrafts-admin/admin/login.html" },
    { "source": "/admin/login/", "destination": "/admin/ssrini-handicrafts-admin/admin/login.html" },
    { "source": "/admin/products", "destination": "/admin/ssrini-handicrafts-admin/admin/products.html" },
    { "source": "/admin/products/", "destination": "/admin/ssrini-handicrafts-admin/admin/products.html" },
    { "source": "/admin/orders", "destination": "/admin/ssrini-handicrafts-admin/admin/orders.html" },
    { "source": "/admin/orders/", "destination": "/admin/ssrini-handicrafts-admin/admin/orders.html" },
    { "source": "/admin/customers", "destination": "/admin/ssrini-handicrafts-admin/admin/customers.html" },
    { "source": "/admin/customers/", "destination": "/admin/ssrini-handicrafts-admin/admin/customers.html" },
    { "source": "/admin/invoices", "destination": "/admin/ssrini-handicrafts-admin/admin/invoices.html" },
    { "source": "/admin/invoices/", "destination": "/admin/ssrini-handicrafts-admin/admin/invoices.html" },
    { "source": "/admin/analytics", "destination": "/admin/ssrini-handicrafts-admin/admin/analytics.html" },
    { "source": "/admin/analytics/", "destination": "/admin/ssrini-handicrafts-admin/admin/analytics.html" },
    { "source": "/admin/reviews", "destination": "/admin/ssrini-handicrafts-admin/admin/reviews.html" },
    { "source": "/admin/reviews/", "destination": "/admin/ssrini-handicrafts-admin/admin/reviews.html" },
    { "source": "/admin/settings", "destination": "/admin/ssrini-handicrafts-admin/admin/settings.html" },
    { "source": "/admin/settings/", "destination": "/admin/ssrini-handicrafts-admin/admin/settings.html" },
    { "source": "/admin/logout", "destination": "/admin/ssrini-handicrafts-admin/admin/logout.html" },
    { "source": "/admin/logout/", "destination": "/admin/ssrini-handicrafts-admin/admin/logout.html" },
    { "source": "/admin/ssrini-handicrafts-admin/admin/:page", "destination": "/admin/ssrini-handicrafts-admin/admin/:page.html" },
    { "source": "/admin/ssrini-handicrafts-admin/admin/:page/", "destination": "/admin/ssrini-handicrafts-admin/admin/:page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff|woff2|ttf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}